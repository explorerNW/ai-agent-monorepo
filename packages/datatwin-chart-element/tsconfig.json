{
  "compilerOptions": {
    "target": "ES2020",
    "paths": {
      "@datatwin/chart-core": ["../datatwin-chart-core/src/index.ts"]
    },
    "module": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  "include": ["src"]
}

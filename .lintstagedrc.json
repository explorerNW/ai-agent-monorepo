{
  "packages/back-end/src/**/*.{ts,js}": [
    "pnpm --filter back-end lint:staged",
    "pnpm --filter back-end format:staged"
  ],
  "packages/front-end/**/*.{ts,tsx,js,jsx}": [
    "pnpm --filter front-end lint:staged",
    "pnpm --filter front-end format:staged",
    "pnpm --filter front-end typecheck"
  ],
  "packages/my-app-angular/**/*.{ts,html}": [
    "pnpm --filter my-app-angular lint:staged"
  ],
  "*.{json,md,yml,yaml,css,scss}": ["prettier --write"]
}

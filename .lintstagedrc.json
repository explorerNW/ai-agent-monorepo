{
  "packages/back-end/src/**/*.{ts,js}": [
    "cd packages/back-end && pnpm lint",
    "cd packages/back-end && pnpm format"
  ],
  "packages/front-end/**/*.{ts,tsx,js,jsx}": [
    "cd packages/front-end && pnpm typecheck"
  ],
  "packages/my-app-angular/**/*.{ts,tsx,js,jsx}": [
    "cd packages/my-app-angular && pnpm lint-staged"
  ],
  "*.{ts,tsx,js,jsx}": ["./node_modules/.bin/eslint --fix", "prettier --write"],
  "*.{json,md,yml,yaml}": ["prettier --write"]
}
